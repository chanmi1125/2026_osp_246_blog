source "https://rubygems.org"

# 로컬 미리보기용 설정입니다.
# 실제 배포는 GitHub Pages가 자체 환경에서 빌드하므로 이 파일의 영향을 받지 않습니다.
# (github-pages gem 은 Ruby 4 를 지원하지 않아 Jekyll 4 를 직접 사용합니다.)
gem "jekyll", "~> 4.4"

group :jekyll_plugins do
  gem "jekyll-remote-theme"
  gem "jekyll-paginate"
  gem "jekyll-seo-tag"
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-gist"
end

# Ruby 3.0 이상에서 로컬 서버 실행에 필요합니다.
gem "webrick"
# Ruby 3.4 이상에서 기본 포함되지 않는 라이브러리
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "ostruct"
gem "faraday-retry"
